import java.util.Arrays;
import java.util.Map;
import java.util.Optional;
import java.util.function.Function;
import java.util.stream.Collectors;

public class MostRepeatedPrimitive {
    public static void main(String[] args) {
        int[] numbers = {10, 20, 30, 20, 40, 20, 10, 30};

        Optional<Integer> mostRepeated = Arrays.stream(numbers)
                .boxed() // Crucial step: Converts int to Integer stream
                .collect(Collectors.groupingBy(Function.identity(), Collectors.counting()))
                .entrySet()
                .stream()
                .max(Map.Entry.comparingByValue())
                .map(Map.Entry::getKey);

        mostRepeated.ifPresent(num -> System.out.println("Most repeated primitive number: " + num));
    }
}

