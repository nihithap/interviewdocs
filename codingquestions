import java.util.Arrays;
import java.util.Map;
import java.util.Optional;
import java.util.function.Function;
import java.util.stream.Collectors;

public class MostRepeatedElement {
    public static void main(String[] args) {
        String[] items = {"apple", "banana", "apple", "cherry", "banana", "apple"};

        // 1. Convert array to stream, group elements by identity, and count them
        Optional<String> mostRepeated = Arrays.stream(items)
                .collect(Collectors.groupingBy(Function.identity(), Collectors.counting())) // Returns Map<String, Long>
                .entrySet()
                .stream() // Stream the Map entries
                .max(Map.Entry.comparingByValue()) // Find entry with maximum count
                .map(Map.Entry::getKey); // Extract the element itself

        // 2. Print the result safely
        if (mostRepeated.isPresent()) {
            System.out.println("Most repeated element: " + mostRepeated.get());
        } else {
            System.out.println("The array is empty.");
        }
    }
}

